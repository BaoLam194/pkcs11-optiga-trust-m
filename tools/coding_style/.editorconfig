root = true

[*]
end_of_line = lf
indent_style = space
indent_size = 4
max_line_length = 100

[*.{c,cpp,cxx,h,hpp,hxx}]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[{CMakeLists.txt,*.cmake,*.cmake.in}]
indent_size = 2
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = off

[*.{yml,yaml}]
indent_size = 2
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = off

[{Jenkinsfile,*.groovy}]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
